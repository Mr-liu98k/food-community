<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodcommunity.mapper.DashboardMapper">

    <select id="countRecipes" resultType="long">SELECT COUNT(*) FROM recipe</select>
    <select id="countComments" resultType="long">SELECT COUNT(*) FROM `comment`</select>
    <select id="countStoreVisits" resultType="long">SELECT COUNT(*) FROM store_visit</select>
    <select id="countReservations" resultType="long">SELECT COUNT(*) FROM reservation</select>
    <select id="countUsers" resultType="long">SELECT COUNT(*) FROM `user`</select>

    <!-- 近 7 天每日发布：缺失日期由 Service 补零 -->
    <select id="dailyRecipesSince" resultType="map">
        SELECT DATE_FORMAT(create_time, '%Y-%m-%d') AS day, COUNT(*) AS cnt
        FROM recipe
        WHERE create_time &gt;= #{startDate}
        GROUP BY DATE_FORMAT(create_time, '%Y-%m-%d')
    </select>

    <select id="categoryDist" resultType="map">
        SELECT c.name AS name, COUNT(r.id) AS cnt
        FROM category c
        LEFT JOIN recipe r ON r.category_id = c.id
        GROUP BY c.id, c.name
        ORDER BY c.sort ASC, c.id ASC
    </select>
</mapper>
