<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodcommunity.mapper.NoticeMapper">

    <select id="selectPage" resultType="com.foodcommunity.entity.Notice">
        SELECT id, title, content, create_time, update_time
        FROM notice
        <where>
            <if test="keyword != null and keyword != ''">
                title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectLatest" resultType="com.foodcommunity.entity.Notice">
        SELECT id, title, content, create_time, update_time
        FROM notice
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <select id="selectById" resultType="com.foodcommunity.entity.Notice">
        SELECT id, title, content, create_time, update_time
        FROM notice
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.foodcommunity.entity.Notice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice (title, content)
        VALUES (#{title}, #{content})
    </insert>

    <update id="update" parameterType="com.foodcommunity.entity.Notice">
        UPDATE notice
        SET title   = #{title},
            content = #{content}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM notice
        WHERE id = #{id}
    </delete>
</mapper>
