<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodcommunity.mapper.UserMapper">

    <resultMap id="UserMap" type="com.foodcommunity.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="intro" property="intro"/>
        <result column="role" property="role"/>
        <result column="is_expert" property="isExpert"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Columns">
        id, username, password, nickname, avatar, intro, role, is_expert, create_time, update_time
    </sql>

    <select id="findByUsername" resultMap="UserMap">
        SELECT
        <include refid="Base_Columns"/>
        FROM `user`
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="findById" resultMap="UserMap">
        SELECT
        <include refid="Base_Columns"/>
        FROM `user`
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="findByIds" resultMap="UserMap">
        SELECT
        <include refid="Base_Columns"/>
        FROM `user`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <insert id="insert" parameterType="com.foodcommunity.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, nickname, avatar, intro, role, is_expert)
        VALUES (#{username}, #{password}, #{nickname}, #{avatar}, #{intro}, #{role}, #{isExpert})
    </insert>

    <update id="updateProfile" parameterType="com.foodcommunity.entity.User">
        UPDATE `user`
        SET nickname = #{nickname},
            avatar   = #{avatar},
            intro    = #{intro}
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE `user`
        SET password = #{password}
        WHERE id = #{id}
    </update>

    <select id="countByRole" resultType="long">
        SELECT COUNT(*)
        FROM `user`
        WHERE role = #{role}
    </select>

    <!-- 管理端用户/管理员分页（password 由实体注解屏蔽，不出现在 JSON） -->
    <select id="selectByRolePage" resultType="com.foodcommunity.entity.User">
        SELECT
        <include refid="Base_Columns"/>
        FROM `user`
        WHERE role = #{role}
        <if test="keyword != null and keyword != ''">
            AND (username LIKE CONCAT('%', #{keyword}, '%') OR nickname LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY id DESC
    </select>

    <update id="updateNickname">
        UPDATE `user`
        SET nickname = #{nickname}
        WHERE id = #{id}
    </update>

    <update id="updateExpert">
        UPDATE `user`
        SET is_expert = #{expert}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `user`
        WHERE id = #{id}
    </delete>
</mapper>
