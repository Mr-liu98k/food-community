# =============================================================
# 美食社区后端环境配置模板
# 复制本文件为 backend/.env 后按本机实际情况修改
# （.env 已被 gitignore，不会提交）
# =============================================================

# ---- 后端服务端口 ----
# 默认 8080；若被其他程序占用（常见）改成 8081 等即可。
# 前端 vite 代理与 scripts/ 下的验收脚本都会自动读取 backend/.env 的这个值，
# 只有【后端本身】需要读它，无需手工加 --server.port。
SERVER_PORT=8080

# ---- MySQL 连接（按本机实际修改）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=food_community
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- JWT 签名密钥（必须 ≥ 32 字符，仅本地开发示例，请勿直接用于生产）----
JWT_SECRET=dev-only-secret-please-change-0123456789abcdef

# ---- 首次启动自动创建的管理员账号（系统内无管理员时生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- AI 美食专家（阿里云百炼 DashScope）----
# 未配置 Key 时后端照常启动，仅 AI 接口返回提示，不影响其它功能
# 取 Key：https://bailian.console.aliyun.com/ → API-KEY 管理
ALIYUN_MAAS_API_KEY=
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
